<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Widget.Oride.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/button_color_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!--        <item name="android:fontFamily">@font/poppins</item>-->
        <item name="fontWeight">500</item>
    </style>


    <style name="Widget.Oride.Button.Round" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/button_color_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!--        <item name="android:fontFamily">@font/poppins</item>-->
        <item name="fontWeight">500</item>
    </style>

    <style name="Widget.Oride.Button.OutlineButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">#212121</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">@color/button_color_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!--        <item name="android:fontFamily">@font/poppins</item>-->
        <item name="fontWeight">500</item>
    </style>

    <style name="Widget.Oride.Button.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/black</item>
        <item name="iconTint">@color/black</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">5dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!--        <item name="android:fontFamily">@font/poppins</item>-->
        <item name="fontWeight">500</item>
    </style>

    <style name="Widget.Oride.Button.NavItem" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/grey</item>
        <item name="iconTint">@color/grey</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!--        <item name="android:fontFamily">@font/poppins</item>-->
        <item name="fontWeight">500</item>
    </style>

