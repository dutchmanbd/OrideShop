<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llBottomSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    style="@style/CardViewTopCornerRounded"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="4dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvRiderRequest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="New Order"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivArrow"
                app:layout_constraintBottom_toBottomOf="parent"
                />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/tvRiderRequest"
                app:srcCompat="@drawable/ic_baseline_arrow_down" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfilePicture"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/rvOrderItem"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Rounded"
                android:src="@drawable/rider_image" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvProfileName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Chris Patt"
                android:textColor="@color/textColor"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                app:layout_constraintStart_toEndOf="@id/ivProfilePicture"
                app:layout_constraintTop_toTopOf="@id/ivProfilePicture"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvOrderId"
                app:layout_constraintVertical_chainStyle="packed"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                android:text="#1234"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                app:layout_constraintStart_toEndOf="@id/ivProfilePicture"
                app:layout_constraintTop_toBottomOf="@id/tvProfileName"
                app:layout_constraintEnd_toStartOf="@id/divider"
                app:layout_constraintBottom_toBottomOf="@id/ivProfilePicture"
                />

            <View
                android:id="@+id/divider"
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_margin="4dp"
                android:background="@color/colorDivider"
                app:layout_constraintTop_toTopOf="@id/tvOrderId"
                app:layout_constraintStart_toEndOf="@id/tvOrderId"
                app:layout_constraintEnd_toStartOf="@id/tvOrderTime"
                app:layout_constraintBottom_toBottomOf="@id/tvOrderId"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvOrderTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="02:25 PM"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                app:layout_constraintStart_toEndOf="@id/divider"
                app:layout_constraintTop_toTopOf="@id/tvOrderId"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/tvOrderId"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrderItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/layout_order_food_detail_item"
                android:clipToPadding="false"
                app:layout_constraintBottom_toTopOf="@id/itemDivider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivProfilePicture"/>

            <View
                android:id="@+id/itemDivider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:background="@color/colorDivider"
                app:layout_constraintBottom_toTopOf="@id/clVat"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rvOrderItem"
                app:layout_constraintHorizontal_chainStyle="spread_inside" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clVat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/itemDivider"
                app:layout_constraintBottom_toTopOf="@id/declineBtn">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvVatLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintWidth_percent="0.6"
                    android:text="+VAT"
                    android:textColor="@color/textColor"
                    android:textStyle="bold"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    app:layout_constraintBottom_toTopOf="@id/vatDivider"
                    app:layout_constraintEnd_toStartOf="@id/placeDivider1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"/>

                <View
                    android:id="@+id/placeDivider1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@id/tvVatLabel"
                    app:layout_constraintEnd_toStartOf="@id/placeDivider2"
                    app:layout_constraintStart_toEndOf="@id/tvVatLabel"
                    app:layout_constraintTop_toTopOf="@id/tvVatLabel"/>

                <View
                    android:id="@+id/placeDivider2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@id/tvVatLabel"
                    app:layout_constraintEnd_toStartOf="@id/tvVat"
                    app:layout_constraintStart_toEndOf="@id/placeDivider1"
                    app:layout_constraintTop_toTopOf="@id/tvVatLabel"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvVat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="$25"
                    android:textColor="@color/textColor"
                    android:textStyle="bold"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    app:layout_constraintBottom_toBottomOf="@id/tvVatLabel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/placeDivider2"
                    app:layout_constraintTop_toTopOf="@id/tvVatLabel"/>

                <View
                    android:id="@+id/vatDivider"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/colorDivider"
                    app:layout_constraintBottom_toTopOf="@id/tvTotalLabel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvVatLabel"
                    app:layout_constraintHorizontal_chainStyle="spread_inside" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvTotalLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintWidth_percent="0.6"
                    android:text="Total"
                    android:textColor="@color/colorBlue"
                    android:textStyle="bold"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/totalDivider"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vatDivider"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"/>

                <View
                    android:id="@+id/totalDivider"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@id/tvTotalLabel"
                    app:layout_constraintEnd_toStartOf="@id/totalDivider2"
                    app:layout_constraintStart_toEndOf="@id/tvTotalLabel"
                    app:layout_constraintTop_toTopOf="@id/tvTotalLabel"/>

                <View
                    android:id="@+id/totalDivider2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@id/tvTotalLabel"
                    app:layout_constraintEnd_toStartOf="@id/tvTotalPrice"
                    app:layout_constraintStart_toEndOf="@id/totalDivider"
                    app:layout_constraintTop_toTopOf="@id/tvTotalLabel"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvTotalPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="$45.00"
                    android:textColor="@color/colorBlue"
                    android:textStyle="bold"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    app:layout_constraintBottom_toBottomOf="@id/tvTotalLabel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/totalDivider2"
                    app:layout_constraintTop_toTopOf="@id/tvTotalLabel"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/declineBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Widget.Oride.Button.Secondary.Rect"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/decline"
                app:layout_constraintTop_toBottomOf="@id/clVat"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/acceptBtn"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/acceptBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Widget.Oride.Button.Rect"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="@string/accept"
                app:layout_constraintStart_toEndOf="@id/declineBtn"
                app:layout_constraintTop_toTopOf="@id/declineBtn"
                app:layout_constraintBottom_toBottomOf="@id/declineBtn"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>