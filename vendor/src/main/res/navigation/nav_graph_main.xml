<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.oride.vendor.presentation.fragments.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_order"
        android:name="com.oride.vendor.presentation.fragments.orders.OrdersFragment"
        android:label="@string/title_order"
        tools:layout="@layout/fragment_orders" />

    <fragment
        android:id="@+id/nav_earnings"
        android:name="com.oride.vendor.presentation.fragments.earnings.EarningsFragment"
        android:label="@string/title_earnings"
        tools:layout="@layout/fragment_earnings" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.oride.vendor.presentation.fragments.settings.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.oride.vendor.presentation.fragments.WelcomeFragment"
        android:label="fragment_welcome"
        tools:layout="@layout/fragment_welcome" >
        <action
            android:id="@+id/action_welcomeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.oride.vendor.presentation.fragments.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_nav_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:id="@+id/orderDetailsFragment"
        android:name="com.oride.vendor.presentation.fragments.orders.OrderDetailsFragment"
        android:label="fragment_order_details"
        tools:layout="@layout/fragment_order_details" />
    <fragment
        android:id="@+id/dishesFragment"
        android:name="com.oride.vendor.presentation.fragments.dish.DishesFragment"
        android:label="DishesFragment"
        tools:layout="@layout/fragment_dishes"/>
    <fragment
        android:id="@+id/addDishesFragment"
        android:name="com.oride.vendor.presentation.fragments.dish.add.AddDishesFragment"
        android:label="Add Dishes"
        tools:layout="@layout/fragment_add_dishes"/>
    <fragment
        android:id="@+id/contactFragment"
        android:name="com.oride.vendor.presentation.fragments.settings.ContactFragment"
        android:label="ContactFragment"
        tools:layout="@layout/fragment_contact"/>
    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.oride.vendor.presentation.fragments.settings.notification.NotificationFragment"
        android:label="NotificationFragment"
        tools:layout="@layout/fragment_notification"/>
    <fragment
        android:id="@+id/webViewFragment"
        android:name="com.oride.vendor.presentation.fragments.settings.WebViewFragment"
        android:label="WebViewFragment"
        tools:layout="@layout/fragment_web_view"/>

</navigation>